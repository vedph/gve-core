# Stage 1: base
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

# Stage 2: build
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["Directory.Packages.props", "."]
COPY ["CadmusGveApi/CadmusGveApi.csproj", "CadmusGveApi/"]
RUN dotnet restore "CadmusGveApi/CadmusGveApi.csproj" -s https://api.nuget.org/v3/index.json --verbosity n /p:Configuration=Release
# copy the content of the API project
COPY . .
# build it
RUN dotnet build "CadmusGveApi/CadmusGveApi.csproj" -c Release -o /app/build --no-restore

# Stage 3: publish
FROM build AS publish
RUN dotnet publish "CadmusGveApi/CadmusGveApi.csproj" -c Release -o /app/publish --no-restore

# Stage 4: final
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "CadmusGveApi.dll"]
