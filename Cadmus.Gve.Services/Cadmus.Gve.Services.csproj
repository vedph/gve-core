<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Authors>Daniele Fusi</Authors>
		<Company>Fusi</Company>
		<Product>Cadmus</Product>
		<Description>Services for Cadmus GVE.</Description>
		<Copyright>by Daniele Fusi 2024</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageTags>Cadmus;services</PackageTags>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<!-- SourceLink-related -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>5.0.4</Version>
		<FileVersion>5.0.4</FileVersion>
		<AssemblyVersion>5.0.4</AssemblyVersion>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Cadmus.Codicology.Parts" />
		<PackageReference Include="Cadmus.Core" />
		<PackageReference Include="Cadmus.General.Parts" />
		<PackageReference Include="Cadmus.Index.Sql" />
		<PackageReference Include="Cadmus.Mongo" />
		<PackageReference Include="Cadmus.Philology.Parts" />
		<PackageReference Include="Cadmus.Seed.Codicology.Parts" />
		<PackageReference Include="Cadmus.Seed.General.Parts" />
		<PackageReference Include="Cadmus.Seed.Philology.Parts" />
		<PackageReference Include="Fusi.Microsoft.Extensions.Configuration.InMemoryJson" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<ProjectReference Include="..\Cadmus.Gve.Parts\Cadmus.Gve.Parts.csproj" />
		<ProjectReference Include="..\Cadmus.Seed.Gve.Parts\Cadmus.Seed.Gve.Parts.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<PackageReference Include="Cadmus.Gve.Parts" />
		<PackageReference Include="Cadmus.Seed.Gve.Parts" />
	</ItemGroup>

</Project>
