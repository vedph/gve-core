<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Authors>Daniele Fusi</Authors>
		<Company>Fusi</Company>
		<Product>GVE data migration</Product>
		<Description>Goethe Venetian Epigrams data migration components.</Description>
		<Copyright>by Daniele Fusi 2025</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageTags>GVE</PackageTags>
		<Version>2.0.4</Version>
		<FileVersion>2.0.4</FileVersion>
		<AssemblyVersion>2.0.4</AssemblyVersion>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Fusi.Tools.Configuration" Version="7.0.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Gve.Text\Gve.Text.csproj" />
	</ItemGroup>

</Project>
