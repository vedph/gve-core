<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Scalar.AspNetCore" />
		<PackageReference Include="Serilog.Extensions.Hosting" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.File" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<ProjectReference Include="..\Gve.Api.Controllers\Gve.Api.Controllers.csproj" />
		<ProjectReference Include="..\Gve.Api.Models\Gve.Api.Models.csproj" />
		<ProjectReference Include="..\Gve.Text\Gve.Text.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<ProjectReference Include="Gve.Api.Controllers" />
		<ProjectReference Include="Gve.Api.Models" />
		<ProjectReference Include="Gve.Text" />
	</ItemGroup>

</Project>
