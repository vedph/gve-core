@Gve.Api_HostAddress = http://localhost:5239

GET {{Gve.Api_HostAddress}}/weatherforecast/
Accept: application/json

### Parse Operations
POST {{Gve.Api_HostAddress}}/text/operations/parse
Accept: application/json
Content-Type: application/json

{
  "text": "3- [*log=\"delete Z\" reason=\"don't like Z\"]\n2=V [*log=\"replace R with V\" *version^:=alpha]\n6=B [*log=\"replace V with B\"]\n(v1:) 2=P [*log=\"replace R with P\" *version^:=beta]\n4<>5\n(v3:) 4<>5 [*version^:=gamma]"
}

