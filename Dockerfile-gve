# Stage 1: base
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/aspnet:11.0 AS base
WORKDIR /app
EXPOSE 8080

# Stage 2: build
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src
COPY ["Directory.Packages.props", "."]
COPY ["Gve.Api/Gve.Api.csproj", "Gve.Api/"]
RUN dotnet restore "Gve.Api/Gve.Api.csproj" -s https://api.nuget.org/v3/index.json --verbosity n /p:Configuration=Release
# copy the content of the API project
COPY . .
# build it
RUN dotnet build "Gve.Api/Gve.Api.csproj" -c Release -o /app/build

# Stage 3: publish
FROM build AS publish
RUN dotnet publish "Gve.Api/Gve.Api.csproj" -c Release -o /app/publish

# Stage 4: final
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Gve.Api.dll"]
