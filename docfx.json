{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": ["*/**/*.csproj"],
          "exclude": [
            "**/*.Test.csproj",
            "**/bin/**",
            "**/obj/**",
            "**/Gve.Demo/**/*.csproj",
            "**/Gve.Demo.Client/**/*.csproj",
            "**/CadmusGveApi/**/*.csproj",
            "**/Gve.Api/**/*.csproj",
            "**/gve/**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml" ]
      },
      {
        "files": [ "*.md", "articles/**.md" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "resource": [
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "gve-doc",
      "_appTitle": "GVE Documentation",
      "_enableSearch": true,
      "pdf": true
    }
  }
}
