@using Gve.Text

@code {
    [Parameter]
    public TreeNode<VarOperation>? Node { get; set; }

    private bool _isExpanded;

    private void ToggleExpandCollapse()
    {
        _isExpanded = !_isExpanded;
    }
}

@if (Node != null)
{
    <FluentTreeItem Text="@(Node.Payload?.ToString() ?? @Node.GetYX().ToString())"
        Expanded="@_isExpanded"
        OnClick="ToggleExpandCollapse">
        @foreach (var child in Node.Children)
        {
            <VarOpTreeNode Node="child" />
        }
    </FluentTreeItem>
}
