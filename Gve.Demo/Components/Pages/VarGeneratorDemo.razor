@page "/demo/var-generator"

<PageTitle>Variant Generator Demo</PageTitle>

<h1>Variant Generator Demo</h1>

<EditForm Model="@this" FormName="demo"
          OnValidSubmit="@ParseText">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <FluentStack Orientation="Orientation.Vertical">
        <FluentTextArea @bind-Value="Text" class="full-width"
                        Label="Text" Required="true"
                        ErrorMessage="Text must be non-empty">
        </FluentTextArea>

        <FluentTextArea @bind-Value="OpText" class="full-width"
                        Label="Operations" Required="true"
                        Rows="5" Style="font-family: monospace"
                        ErrorMessage="Operations must be non-empty">
        </FluentTextArea>

        <FluentButton Type="ButtonType.Submit"
                      Appearance="Appearance.Accent">Submit</FluentButton>
    </FluentStack>
</EditForm>

<FluentTreeView Items="@Root">
    <VarOpTreeNode Node="Root" />
</FluentTreeView>

@if (CanGenerate)
{
    <FluentToolbar>
        <FluentSelect Items="@VariantTags" />
        <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                      Appearance="Appearance.Accent"
                      Loading="@IsGenerating"
                      OnClick="@Generate">
            Generate
        </FluentButton>
    </FluentToolbar>

    @if (GeneratedText != null)
    {
        <code>
            <pre>@GeneratedText</pre>
        </code>
    }
}
