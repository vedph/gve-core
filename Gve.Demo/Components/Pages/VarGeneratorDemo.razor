@page "/demo/var-generator"

<PageTitle>Variant Generator Demo</PageTitle>

<h1>Variant Generator Demo</h1>

<EditForm Model="@this" OnValidSubmit="@ParseText">
    <FluentGrid>
        <FluentGridItem xs="12" sm="12">
            <FluentTextArea @bind-Value="Text" class="full-width"
                Label="Text" Required="true"
                ErrorMessage="Text must be non-empty"></FluentTextArea>
        </FluentGridItem>

        <FluentGridItem>
            <FluentButton OnClick="@ParseText">Submit</FluentButton>
        </FluentGridItem>
    </FluentGrid>
    
</EditForm>