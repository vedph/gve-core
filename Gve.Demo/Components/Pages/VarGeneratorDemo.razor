@page "/demo/var-generator"
@rendermode InteractiveServer

<PageTitle>Variant Generator Demo</PageTitle>

<h1>Variant Generator Demo</h1>

<EditForm Model="@this" FormName="demo"
          OnValidSubmit="@Parse">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <FluentStack Orientation="Orientation.Vertical">
        <FluentTextArea @bind-Value="Text" class="full-width"
                        Label="Text" Required="true"
                        ErrorMessage="Text must be non-empty">
        </FluentTextArea>

        <FluentTextArea @bind-Value="OpText" class="full-width"
                        Label="Operations" Required="true"
                        Rows="10" Style="font-family: monospace"
                        ErrorMessage="Operations must be non-empty">
        </FluentTextArea>

        <FluentButton Type="ButtonType.Submit"
                      Appearance="Appearance.Accent">Configure</FluentButton>
    </FluentStack>
</EditForm>

<TreeNodeView Root="@Root"></TreeNodeView>

@if (CanGenerate)
{
    <FluentToolbar>
        <FluentSelect Items="@VariantTags"
        @bind-SelectedOption="SelectedVariantTag" />
        <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
        Type="ButtonType.Button"
        Appearance="Appearance.Accent"
        Loading="@IsGenerating"
        OnClick="Generate">
            Generate
        </FluentButton>
    </FluentToolbar>

    @if (LogEntries.Count > 0)
    {
        <FluentAccordion>
            <FluentAccordionItem Heading="Log">
                <ChildContent>
                    <ol>
                        @foreach (var entry in LogEntries)
                        {
                            <li>@entry</li>
                        }
                    </ol>
                </ChildContent>
            </FluentAccordionItem>
        </FluentAccordion>
    }

    @if (Steps.Count > 0)
    {
        <FluentAccordion>
            <FluentAccordionItem Heading="Steps">
                <ChildContent>
                    <FluentDataGrid Items="Steps.AsQueryable()"
                    GenerateHeader="GenerateHeaderOption.Default">
                        <PropertyColumn Title="tag" Property="@(s => s.VersionTag)" />
                        <PropertyColumn Title="operation" Property="@(s => s.Operation)" />
                        <PropertyColumn Title="set" Property="@(s => s.Context.Set.GetText(true))" />
                        <PropertyColumn Title="a-nodes" Property="@(s => s.Context.GetAnnText())" />
                    </FluentDataGrid>
                </ChildContent>
            </FluentAccordionItem>
        </FluentAccordion>
    }

    <h3>Results</h3>
    <p>@Results.Count</p>
    <table>
        <thead>
            <tr>
                <th>tag</th>
                <th>value</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Results)
            {
                <tr>
                    <td class="fit-width">@result.Item1</td>
                    <td class="fit-width">@result.Item2.GetText(false)</td>
                    <td class="fit-width">
                        <FluentButton IconEnd="@(new Icons.Regular.Size16.Eye())"
                        @onclick="@(()=> { SelectResult(result); })" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @*
    <FluentGrid>
        <FluentGridItem xs="12" sm="6">
            <FluentDataGrid Items="Results.AsQueryable()"
                            GenerateHeader="GenerateHeaderOption.Default">
                <PropertyColumn Title="tag" Property="@(t => t.Item1)" />
                <PropertyColumn Title="value" Property="@(t => t.Item2.GetText(false))" />
                <TemplateColumn Title="" Align="@Align.End" Context="t">
                    <FluentButton IconEnd="@(new Icons.Regular.Size16.Eye())"
                                  @onclick="@(()=> { SelectResult(t); })" />
                </TemplateColumn>
            </FluentDataGrid>
        </FluentGridItem>

        @if (SelectedResult != null)
        {
            <FluentGridItem xs="12" sm="6">
                <CharNodeSetTable Set="SelectedResult.Item2" />
            </FluentGridItem>
        }
    </FluentGrid>
 *@
    @if (SelectedResult != null)
    {
        <div>
            <CharNodeSetTable Set="SelectedResult.Item2" />
        </div>
    }
}
