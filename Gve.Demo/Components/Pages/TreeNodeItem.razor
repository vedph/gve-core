@using Gve.Text

@if (Node != null)
{
    <li class="@ItemClass">
        <span @onclick="Toggle">@(Node.Label)</span>
        @if (Node.Children.Count > 0 && Node.IsExpanded)
        {
            <ul class="tree-node">
                @foreach (var child in Node.Children)
                {
                    <TreeNodeItem Node="child" />
                }
            </ul>
        }
    </li>
}
