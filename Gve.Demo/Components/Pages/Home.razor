@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<RadzenCard>
    <RadzenTextArea @bind-Value="@Text" Placeholder="text" class="w-100" />
    <RadzenTextArea @bind-Value="@OperationText" Placeholder="text" class="w-100" />
    <RadzenButton Text="Parse" Click="ParseOperationText" ButtonStyle="ButtonStyle.Primary" />
    <ol>
        @foreach (var op in Operations)
        {
            <li>@op</li>
        }
    </ol>
</RadzenCard>
