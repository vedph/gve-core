@page "/"
@rendermode InteractiveServer
@inject NotificationService NotificationService
@using Gve.Text

<PageTitle>Home</PageTitle>

<h1>Chain</h1>
<RadzenCard>
    <RadzenTextArea @bind-Value="@Text" Placeholder="text" class="w-100" />
    <RadzenTextArea @bind-Value="@OperationText" Placeholder="text"
                    class="w-100" Rows="8" />
    <RadzenButton Text="Parse" Click="ParseOperationText"
                  ButtonStyle="ButtonStyle.Primary" />
    <RadzenPanel AllowCollapse="true">
        <HeaderTemplate>
            <RadzenText TextStyle="TextStyle.H6"
                        Class="rz-display-flex rz-align-items-center rz-m-0">
                <RadzenIcon Icon="list_alt" class="rz-mr-1" /> operations
            </RadzenText>
        </HeaderTemplate>
        <ChildContent>
            <RadzenDataGrid AllowAlternatingRows="true" Data="@Operations"
                            TItem="CharChainOperation" @ref="OperationsGrid"
                            SelectionMode="DataGridSelectionMode.Single"
                            Title="operations">
                <Columns>
                    <RadzenDataGridColumn TItem="string" Property="Type" Title="type" />
                    <RadzenDataGridColumn TItem="string" Property="InputTag" Title="tag-in" />
                    <RadzenDataGridColumn TItem="string" Property="OutputTag" Title="tag-out" />
                    <RadzenDataGridColumn TItem="string" Property="At" Title="at" />
                    <RadzenDataGridColumn TItem="string" Property="Run" Title="run" />
                    <RadzenDataGridColumn TItem="string" Property="Value" Title="value" />
                </Columns>
            </RadzenDataGrid>

            @if (Operations?.Count > 0)
            {
                <table>
                    <thead>
                        <tr class="rz-background-color-base-500 rz-color-white">
                            <th>type</th>
                            <th>tin</th>
                            <th>tout</th>
                            <th>at</th>
                            <th>run</th>
                            <th>value</th>
                            <th>op</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in Operations)
                        {
                            <tr>
                                <td>@op.Type</td>
                                <td>@op.InputTag</td>
                                <td>@op.OutputTag</td>
                                <td>@op.At</td>
                                <td>@op.Run</td>
                                <td>@op.Value</td>
                                <td>@op</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </RadzenPanel>
</RadzenCard>

<RadzenCard>
    <RadzenButton Text="Run" Click="RunOperations" />

    <div class="rz-m-12">
        <RadzenProgressBar Value="100" Visible="IsBusy"
                           Mode="ProgressBarMode.Indeterminate" />
    </div>

    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="texts">
                <table>
                    <thead>
                        <tr class="rz-background-color-base-500 rz-color-white">
                            <th>tag</th>
                            <th>text</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in TaggedTexts)
                        {
                            <tr>
                                <td>@t.Item1</td>
                                <td>@t.Item2</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </RadzenTabsItem>
            <RadzenTabsItem Text="steps">
                <table>
                    <thead>
                        <tr class="rz-background-color-base-500 rz-color-white">
                            <th>tin</th>
                            <th>tout</th>
                            <th>operation</th>
                            <th>feats</th>
                            <th>node feats</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in Steps)
                        {
                            <tr>
                                <td>@step.InputTag</td>
                                <td>@step.OutputTag</td>
                                <td>@step.Operation</td>
                                <td>
                                    <ol>
                                        @foreach (var f in @step.FeatureSet.Features)
                                        {
                                            <li>@f</li>
                                        }
                                    </ol>
                                </td>
                                <td>
                                    <ol>
                                        @foreach (var kvp in @step.FeatureSet.NodeFeatures)
                                        {
                                            <li>
                                                <b>@kvp.Key</b>
                                                <ul>
                                                    @foreach (var f in kvp.Value)
                                                    {
                                                        <li>@f</li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ol>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>
