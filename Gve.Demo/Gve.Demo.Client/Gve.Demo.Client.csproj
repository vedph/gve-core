<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<Version>5.0.4</Version>
		<FileVersion>5.0.4</FileVersion>
		<AssemblyVersion>5.0.4</AssemblyVersion>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Assets\Presets.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="bClipboard" />
		<PackageReference Include="Radzen.Blazor" />
		<PackageReference Include="HighlightBlazor" />
		<PackageReference Include="Z.Blazor.Diagrams" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
	  <ProjectReference Include="..\..\Gve.Migration\Gve.Migration.csproj" />
	  <ProjectReference Include="..\..\Gve.Text\Gve.Text.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<PackageReference Include="Gve.Migration" />
		<PackageReference Include="Gve.Text" />
	</ItemGroup>

</Project>
