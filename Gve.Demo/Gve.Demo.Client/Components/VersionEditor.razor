<!-- new version -->
<RadzenRow Gap="2rem" RowGap="2rem" class="rz-m-0 rz-m-md-12">
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">new version</RadzenText>
            <RadzenTextArea @bind-Value="@NewVersion" class="rz-w-100"
                Placeholder="version" Rows="3" />
            <RadzenButton Click="@AddVersion">add</RadzenButton>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<!-- versions -->
<RadzenRow Gap="2rem" RowGap="2rem" class="rz-m-0 rz-m-md-12">
    
    <RadzenDataList Data="@Versions" TItem="@TaggedText" class="rz-w-100">
        <Template Context="version">
            <RadzenCard Variant="Variant.Outlined" class="rz-p-0 rz-w-100">
                <RadzenRow class="flex-row rz-w-100">
                    <RadzenColumn class="col-title flex-col-auto">@version.Tag</RadzenColumn>
                    <RadzenColumn class="flex-col-auto">
                        <div class="button-row">
                            <RadzenButton Click="@(() => MoveVersionUp(version))"
                                          Icon="arrow_upward" />
                            <RadzenButton Click="@(() => MoveVersionDown(version))"
                                          Icon="arrow_downward" />
                            <RadzenButton Click="@(() => RemoveVersion(version))"
                                Icon="delete" ButtonStyle="ButtonStyle.Danger"/>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn class="flex-col-fill">
                        <RadzenText>@version.Text</RadzenText>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </Template>
    </RadzenDataList>
</RadzenRow>
