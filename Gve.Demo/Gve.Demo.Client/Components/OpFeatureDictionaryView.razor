<RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
    <RadzenDropDown Style="width: 6em" Data="@Tags" @bind-Value="@SelectedTag" TValue="string" />
    @if (SelectedTag != null)
    {
        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="clear" Click="@(() => ClearFeatures())" />
    }
</RadzenStack>
@if (TagFeatures.Count > 0)
{
    <ul style="column-width: 16rem; column-gap: 1.5rem; list-style: none; padding: 0; margin-top: 0.5rem;">
        @foreach (var kvp in TagFeatures)
        {
            <li style="break-inside: avoid; margin-bottom: 0.4rem;">
                <strong>@kvp.Key</strong>
                <span style="color:darkgreen;font-weight:bold">@GetNodeLabel(kvp.Key)</span>
                <ul>
                    @foreach (var f in kvp.Value)
                    {
                        <li><span style="@(f.Name.StartsWith('$')? "color:orange" : "")">@f.Name</span> : @f.Value</li>
                    }
                </ul>
            </li>
        }
    </ul>
}